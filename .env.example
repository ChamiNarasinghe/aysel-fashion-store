
# Supabase Configuration
# Copy this file to .env.local and replace the placeholders.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side only. Never expose this key in browser code.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Recovery cookie signing secret.
# Used to HMAC-sign the password-reset cookie so it cannot be forged.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 hex characters (64 chars). Keep this secret.
RECOVERY_SIGNING_SECRET=your_64_char_hex_secret_here
